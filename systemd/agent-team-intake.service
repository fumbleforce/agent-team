[Unit]
Description=Linear approval intake for agent-team projects
After=network-online.target agent-team-coordinator.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repo/agent-team
EnvironmentFile=%h/.config/agent-team/service.env
EnvironmentFile=%h/.config/agent-team/linear.env
ExecStart=/usr/bin/node %h/repo/agent-team/linear-intake.mjs --config %h/.config/agent-team/intake.json
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
