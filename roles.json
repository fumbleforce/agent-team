{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "OWNER_PREFERENCES.md"
  ],
  "command": {
    "team": {
      "description": "Message the current project's team or inspect its progress",
      "agent": "team-owner",
      "template": "$ARGUMENTS"
    }
  },
  "agent": {
    "team-owner": {
      "description": "Owner-facing team messaging, decisions and concise cross-project status",
      "mode": "primary",
      "prompt": "{file:./agents/team-owner.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "question": "allow"
      }
    },
    "team-coordinator": {
      "description": "Coordinates one bounded project PM, UX, development, testing and review cycle.",
      "mode": "primary",
      "prompt": "{file:./agents/team-coordinator.md}",
      "steps": 100,
      "permission": {
        "question": "deny",
        "task": {
          "*": "deny",
          "team-pm": "allow",
          "team-ux": "allow",
          "team-dev": "allow",
          "team-tester": "allow",
          "team-reviewer": "allow"
        },
        "bash": {
          "*": "allow",
          "*git push*--force*": "deny",
          "*git push*-f*": "deny",
          "*git reset --hard*": "deny",
          "*npm run *deploy*": "deny",
          "*npm run test:live*": "deny",
          "*npm run db:reset*": "deny"
        }
      }
    },
    "team-ideation": {
      "description": "Proposes substantial, evidence-based product features for owner approval in the tracker.",
      "mode": "primary",
      "prompt": "{file:./agents/team-ideation.md}",
      "steps": 40,
      "permission": {
        "task": "deny",
        "question": "deny",
        "tracker_*": "deny",
        "bash": {
          "*": "deny",
          "git log --oneline*": "allow",
          "git status*": "allow",
          "git ls-files*": "allow",
          "ls*": "allow",
          "cat*": "allow",
          "head*": "allow",
          "wc*": "allow",
          "rg*": "allow",
          "grep*": "allow",
          "find*": "allow"
        }
      }
    },
    "team-pm": {
      "description": "Maintains a project's scoped tracker backlog and selects actionable work.",
      "mode": "subagent",
      "prompt": "{file:./agents/team-pm.md}",
      "steps": 35,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny"
      }
    },
    "team-ux": {
      "description": "Specifies and reviews interactions, accessible states and visual consistency.",
      "mode": "subagent",
      "prompt": "{file:./agents/team-ux.md}",
      "steps": 30,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "question": "deny",
        "tracker_*": "deny"
      }
    },
    "team-dev": {
      "description": "Implements one scoped issue with targeted regression checks and documentation.",
      "mode": "subagent",
      "prompt": "{file:./agents/team-dev.md}",
      "steps": 90,
      "permission": {
        "task": "deny",
        "question": "deny",
        "tracker_*": "deny"
      }
    },
    "team-tester": {
      "description": "Independently validates acceptance criteria and regression behavior.",
      "mode": "subagent",
      "prompt": "{file:./agents/team-tester.md}",
      "steps": 60,
      "permission": {
        "task": "deny",
        "question": "deny",
        "tracker_*": "deny"
      }
    },
    "team-reviewer": {
      "description": "Independently reviews correctness, maintainability and verification evidence.",
      "mode": "subagent",
      "prompt": "{file:./agents/team-reviewer.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "task": "deny",
        "question": "deny",
        "tracker_*": "deny"
      }
    }
  }
}
