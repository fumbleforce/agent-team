{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["OWNER_PREFERENCES.md"],
  "team": { "defaultRoles": ["team-researcher", "team-writer", "team-editor"] },
  "agent": {
    "team-owner": { "description": "Owner-facing desk messaging and concise status", "mode": "primary", "prompt": "{file:./agents/team-owner.md}", "permission": { "edit": "deny", "task": "deny", "question": "allow" } },
    "team-coordinator": {
      "description": "Coordinates one bounded research-and-writing cycle.", "mode": "primary", "prompt": "{file:./agents/team-coordinator.md}", "steps": 80,
      "permission": { "question": "deny", "task": { "*": "deny", "team-pm": "allow", "team-researcher": "allow", "team-writer": "allow", "team-editor": "allow" },
        "bash": { "*": "allow", "*git push*--force*": "deny", "*git push*-f*": "deny", "*git reset --hard*": "deny" } }
    },
    "team-ideation": { "description": "Proposes briefs worth writing, each with the evidence gap it fills.", "mode": "primary", "prompt": "{file:./agents/team-ideation.md}", "steps": 30,
      "permission": { "task": "deny", "question": "deny", "tracker_*": "deny", "bash": { "*": "deny", "git log --oneline*": "allow", "ls*": "allow", "cat*": "allow", "rg*": "allow", "grep*": "allow", "find*": "allow" } } },
    "team-pm": { "description": "Maintains the desk's backlog of briefs and selects actionable work.", "mode": "subagent", "prompt": "{file:./agents/team-pm.md}", "steps": 30, "permission": { "edit": "deny", "bash": "deny", "task": "deny", "question": "deny" } },
    "team-researcher": { "description": "Gathers and verifies sources for one brief.", "mode": "subagent", "prompt": "{file:./agents/team-researcher.md}", "steps": 60, "permission": { "task": "deny", "question": "deny", "tracker_*": "deny" } },
    "team-writer": { "description": "Writes or revises one piece from the verified notes.", "mode": "subagent", "prompt": "{file:./agents/team-writer.md}", "steps": 60, "permission": { "task": "deny", "question": "deny", "tracker_*": "deny", "bash": "deny" } },
    "team-editor": { "description": "Independently edits for accuracy, structure and the stated question.", "mode": "subagent", "prompt": "{file:./agents/team-editor.md}", "steps": 40, "permission": { "edit": "deny", "task": "deny", "question": "deny", "tracker_*": "deny", "bash": "deny" } }
  }
}
