{
  "name": "@fumbleforce/agent-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-team": "bin/agent-team.ts"
  },
  "files": [
    "dist"
  ],
  "description": "Provider-neutral agent teams: one coordinator on one port, workers that run one engine session per agent, and adapters for engines, source hosts, trackers, storage and hosting",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"adapters/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:sim": "node --test \"packages/**/*.sim.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @agent-team/web",
    "lint": "node scripts/lint-neutral.ts && node scripts/lint-ui.ts && node scripts/lint-sql.ts",
    "check": "npm run typecheck && npm run biome && npm run lint && npm run test:web",
    "build:web": "npm run build -w @agent-team/web",
    "build:dist": "node scripts/build-dist.ts",
    "prepack": "npm run build:web && node scripts/build-dist.ts",
    "postpack": "node scripts/build-dist.ts --restore",
    "test:pack": "node scripts/test-pack.ts",
    "coordinator": "node packages/coordinator/src/main.ts",
    "worker": "node packages/worker/src/main.ts",
    "up": "node bin/agent-team.ts up",
    "demo": "node bin/agent-team-demo.ts",
    "test:e2e": "playwright test",
    "pilot": "node scripts/pilot-turn.ts",
    "test:postgres": "node --test --test-concurrency=1 \"packages/**/*.test.ts\"",
    "test:web": "vitest run --root packages/web",
    "biome": "biome lint ."
  },
  "workspaces": [
    "packages/*",
    "adapters/storage"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "happy-dom": "^20.14.5",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
