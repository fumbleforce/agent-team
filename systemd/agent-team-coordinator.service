[Unit]
Description=Shared agent-team job coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repo/agent-team
EnvironmentFile=%h/.config/agent-team/service.env
ExecStart=/usr/bin/node %h/repo/agent-team/queue.mjs --config %h/.config/agent-team/coordinator.json
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
