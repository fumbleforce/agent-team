{
  "name": "@fumbleforce/agent-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral agent delivery teams: adapters for engines, SCMs, trackers, launchers and hosting, with a durable multi-project queue, git-backed project memory and a resident PM",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "test": "node --test 'core/**/*.test.mjs' 'adapters/**/*.test.mjs'",
    "coordinator": "node core/queue.mjs --config coordinator.example.json",
    "worker": "node core/worker.mjs --config worker.example.json",
    "intake": "node core/intake.mjs --config intake.example.json",
    "dashboard": "node core/dashboard.mjs --config dashboard.example.json",
    "pm": "node core/pm.mjs --config pm.example.json",
    "lint": "node scripts/lint-neutral.mjs",
    "check": "node scripts/check-syntax.mjs && npm run lint",
    "seed-memory": "node core/seed-memory.mjs"
  }
}
